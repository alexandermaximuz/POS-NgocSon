{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep",
      "Bash(pnpm install)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm verify*)",
      "Bash(pnpm test*)",
      "Bash(pnpm db:types*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b*)",
      "Bash(git push origin phase-*)"
    ],
    "ask": [
      "Bash(supabase db push*)",
      "Bash(gh pr create*)",
      "Bash(git push origin main*)",
      "Bash(git merge*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(rm -rf*)",
      "Read(.env.local)",
      "Read(.env*)"
    ]
  }
}
